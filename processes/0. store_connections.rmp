      <operator activated="true" class="blending:generate_columns" compatibility="11.0.001" expanded="true" height="82" name="Generate Attributes" width="90" x="313" y="646">
        <list key="function_descriptions">
          <parameter key="name" value="replaceAll(player_name, &quot; \\(\\d+\\)$&quot;, &quot;&quot;)"/>
          <parameter key="position" value="replaceAll(position, &quot;.* - &quot;, &quot;&quot;)"/>
          <parameter key="age" value="-date_diff(&#10;  date_now(),&#10;  date_of_birth,&#10;  DATE_UNIT_YEAR,&#10;  &quot;Europe/Lisbon&quot;&#10;)"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Europe/Lisbon"/>
      </operator>
